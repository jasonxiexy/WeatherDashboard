generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}

model Weather {
  id          Int      @id @default(autoincrement())
  city        String   @unique
  country     String
  latitude    Float
  longitude   Float
  temperature Float
  weatherCode Int
  updatedAt   DateTime @updatedAt @default(now())
}